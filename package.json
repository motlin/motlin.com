{
	"name": "motlin-com-docusaurus",
	"version": "0.0.0",
	"private": true,
	"scripts":
	{
		"preinstall": "npx only-allow pnpm",
		"docusaurus": "docusaurus",
		"start": "docusaurus start --port 4000",
		"start:with-download": "pnpm run download-github-data && pnpm run start",
		"build": "docusaurus build",
		"swizzle": "docusaurus swizzle",
		"deploy": "docusaurus deploy",
		"clear": "docusaurus clear",
		"serve": "docusaurus serve",
		"write-translations": "docusaurus write-translations",
		"write-heading-ids": "docusaurus write-heading-ids",
		"oxlint": "vp lint . --fix",
		"oxlint:ci": "vp lint . --format github",
		"fmt": "oxfmt-next-line",
		"fmt:ci": "oxfmt-next-line --check",
		"fallow": "fallow fix --yes --no-create-config",
		"fallow:ci": "fallow dead-code",
		"typecheck": "tsc --noEmit",
		"download-github-data": "tsx scripts/download-github-data.ts",
		"build:with-download": "pnpm run download-github-data && pnpm run build",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"test": "node node_modules/vitest/dist/cli.js",
		"test:ui": "node node_modules/vitest/dist/cli.js --ui",
		"prepare": "VITE_GIT_HOOKS=0 vp config"
	},
	"dependencies":
	{
		"@docusaurus/core": "^3.10.2",
		"@docusaurus/plugin-google-gtag": "^3.10.2",
		"@docusaurus/plugin-ideal-image": "^3.10.2",
		"@docusaurus/preset-classic": "^3.10.2",
		"@docusaurus/theme-common": "^3.10.2",
		"@docusaurus/theme-mermaid": "^3.10.2",
		"@giscus/react": "^3.1.0",
		"@mdx-js/react": "^3.1.1",
		"@saucelabs/theme-github-codeblock": "^0.3.0",
		"node-fetch": "^3.3.2",
		"prism-react-renderer": "^2.3.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-icons": "^5.7.0",
		"react-markdown": "^10.1.0",
		"zod": "^4.6.7"
	},
	"devDependencies":
	{
		"@chromatic-com/storybook": "^5.6.0",
		"@docusaurus/eslint-plugin": "^3.10.2",
		"@docusaurus/types": "^3.8.0",
		"@storybook/addon-a11y": "^10.6.6",
		"@storybook/addon-docs": "^10.6.6",
		"@storybook/addon-onboarding": "^10.6.6",
		"@storybook/react": "^10.6.6",
		"@storybook/react-vite": "^10.6.6",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@types/react": "19.1.2",
		"eslint-plugin-storybook": "^10.6.6",
		"fallow": "^3.39.0",
		"infima": "0.2.0-alpha.45",
		"jsdom": "^30.1.3",
		"markdownlint-cli2": "^0.24.0",
		"playwright": "^1.65.0",
		"raw-loader": "^4.0.2",
		"storybook": "^10.6.6",
		"tsx": "^4.23.15",
		"typescript": "~6.0.3",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	},
	"browserslist":
	{
		"production": [
			">0.5%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 3 chrome version",
			"last 3 firefox version",
			"last 5 safari version"
		]
	},
	"engines":
	{
		"node": ">=22.0"
	},
	"packageManager": "pnpm@12.18.0"
}
